# ============================================================================
# Modelo das variáveis de ambiente do backend da Cycle Sown.
#
# Copie este arquivo para `.env` (na mesma pasta) e preencha os valores.
# O `.env` de verdade NUNCA vai para o Git (está no .gitignore) — este
# `.env.example` vai, por isso aqui só existem valores de exemplo.
# Em produção, cadastre as mesmas variáveis no painel da hospedagem.
# ============================================================================

# --- Banco de dados (MySQL) -------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-pela-senha-do-mysql
DB_NAME=cyclesown
# Conexão pela rede pública (ex.: MySQL do Railway) costuma exigir SSL.
# Em produção use DB_SSL=true; em dev local, deixe comentado.
# DB_SSL=true

# --- Autenticação -----------------------------------------------------------
# Assina os tokens de login (JWT). Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# --- Rastreamento de produtos (routes/produtoEventos.js) --------------------
# Chave do hash que identifica a "sessão" de quem vê/clica num produto, sem
# guardar o IP. OBRIGATÓRIA: sem ela (ou com menos de 32 caracteres) o
# servidor não inicia. Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_SECRET=troque-por-64-caracteres-aleatorios-gerados-com-o-comando-acima

# --- Servidor ---------------------------------------------------------------
PORT=3000
# Origens liberadas no CORS (separadas por vírgula) — só importa quando o
# frontend roda em outra origem (ex.: Live Server na porta 5500).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Leitura de laudo por IA (laudo-parser-route.js) ------------------------
ANTHROPIC_API_KEY=
